# Copy to .env and fill in. .env is gitignored and never committed.

# Pixabay video search (https://pixabay.com/api/docs/)
PIXABAY_API_KEY=

# OpenRouter - vision (Llama 4 Scout) + script (DeepSeek) (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Telegram upload notifications (optional; leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API OAuth credential files (gitignored).
# Obtain from Google Cloud Console; run the OAuth flow once to mint token.json.
YOUTUBE_CLIENT_SECRET_FILE=credentials/client_secret.json
YOUTUBE_TOKEN_FILE=credentials/token.json
